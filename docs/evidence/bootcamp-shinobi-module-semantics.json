      "tier": "original",
      "claim": "Final client MODULE_RESIST_EFFECT 413 selects tooltip 2127 with no percentage suffix; legacy SERVER_LIGHT_RESIST188 selects percentage tooltip489.",
      "source": "module-effect-selected.json",
      "locations": {
        "effect_name_store": 1605,
        "effect_class_assignment": 13133,
