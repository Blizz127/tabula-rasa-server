  "rules": [
    {
      "id": "equipable_empty_resistance_list",
      "tier": "original",
      "rule": "An EQUIPABLE tooltip entry is a two-tuple (skill_requirement, resistance_list). The resistance field must remain iterable; emit [] when there are no entries. The absent skill requirement is the nested pair (None, None), as established by the later hover audit.",
      "reason": "HasEquipableInfo checks augmentation presence; GetEquipableResistances returns the second tuple member directly. The elemental-icon loader unconditionally iterates it.",
      "implementation": "src/Rasa.Game/Packets/MapChannel/Server/ItemTemplateTooltipInfoPacket.cs:Write",
      "confidence": "high"
    },
    {
      "id": "recruit_clothing_is_not_armor",
      "tier": "original",
      "rule": "Classes 10000068/69/70 are legitimate equipable Item classes, augmentation [4,6], with slots 2/16/15 and no Armor 51 or armorclass data. Their item durability 35/59/70 is not player armor absorption.",
      "corroboration": "7Lrst9SG3pk A3-035 at 321.467 s, A3-040 at 324.467 s, A3-046 at 332.467 s show Recruit Boots/Legs/Vest comparison tooltips without Body Armor/Regen/Resistance fields.",
      "implementation": "src/Rasa.Game/Managers/ManifestationManager.cs:UpdateStatsValues now suppresses the non-armor warning for recognized equipable clothing, retaining malformed-class detection.",
      "confidence": "high",
      "unverified": "The protocol repair establishes no new clothing stats. No original server resistance grants are recovered; current seed has none for these templates."
    },
    {
      "id": "equipable_absent_skill_pair",
      "tier": "original",
      "rule": "When an equipable has no skill requirement, serialize its skill field as (None, None). The complete empty EQUIPABLE payload is ((None, None), []). Preserve any existing skill identifier, skill level and resistances.",
      "source": "tooltipwindow._AddSkillSlot source line 1564, offsets 248–257; gameuiutil.GetEquipableSkillRequirements source line 542, offsets 47–54; gameuiutil._GetClassPowerLevel source line 1358, offsets 58–73",
      "reason": "Both consumers unconditionally unpack two values. Tooltip lines 1566–1569 explicitly accept None members; the icon consumer checks both for None. Actor.GetSkillLevel safely uses dictionary.get(skillId, 0).",
      "implementation": "src/Rasa.Game/Packets/MapChannel/Server/ItemTemplateTooltipInfoPacket.cs:Write",
      "confidence": "high",
      "supersedes": "The earlier claim that scalar None was valid for the skill field was incorrect. The earlier resistance-list repair remains valid. No skill or stat is added."
    }
  ],
