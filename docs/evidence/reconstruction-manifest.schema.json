{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rasa-reconstruction-manifest/1",
  "title": "Rasa.NET evidence-bounded reconstruction manifest",
  "description": "Provenance labels for every reconstructed row and field of one content segment (AGENTS.md, 'Evidence-bounded reconstruction (user decision, 2026-09-13)'). Shared by every segment. The tier rules that JSON Schema cannot express (footage event resolution, time tolerance, corrected text, position keys, source kinds per tier, approved owner decisions, optional columns) are enforced by src/Rasa.Test/Reconstruction/ManifestValidator.cs.",
  "type": "object",
  "required": [
    "schema",
    "policy",
    "segment",
    "sources",
    "scope",
    "rows",
    "omitted",
    "accepted_definition_gaps",
    "accepted_content_gaps",
    "gaps",
    "non_content_settings",
    "changes"
  ],
  "properties": {
    "schema": { "const": "rasa-reconstruction-manifest/1" },
    "policy": { "const": "AGENTS.md#evidence-bounded-reconstruction-user-decision-2026-09-13" },
    "segment": {
      "type": "object",
      "required": ["id", "map_context_ids", "map_version", "missions", "client_version"],
      "properties": {
        "id": { "type": "string" },
        "map_context_ids": { "type": "array", "items": { "type": "integer" } },
        "map_version": { "type": "integer" },
        "missions": { "type": "array", "items": { "type": "integer" } },
        "client_version": { "type": "string" }
      }
    },
    "sources": { "type": "object", "additionalProperties": { "$ref": "#/$defs/source" } },
    "scope": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table", "key_ranges"],
        "properties": {
          "table": { "type": "string" },
          "key_ranges": { "type": "object", "additionalProperties": { "$ref": "#/$defs/key_range" } }
        }
      }
    },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table", "what", "reason", "gap"],
        "properties": {
          "table": { "type": "string" },
          "what": { "type": "string" },
          "reason": { "type": "string" },
          "gap": { "type": "string" }
        }
      }
    },
    "accepted_definition_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mission_id", "gaps", "reason", "slice"],
        "properties": {
          "mission_id": { "type": "integer" },
          "gaps": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" },
          "slice": { "$ref": "#/$defs/slice" }
        }
      }
    },
    "accepted_content_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table", "key", "gaps", "reason"],
        "properties": {
          "table": { "type": "string" },
          "key": { "type": "object" },
          "gaps": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "summary", "evidence", "closes_with", "surfaced_by"],
        "properties": {
          "id": { "type": "string", "pattern": "^GAP-" },
          "summary": { "type": "string" },
          "evidence": { "$ref": "#/$defs/text_or_list" },
          "closes_with": { "type": "string" },
          "surfaced_by": { "$ref": "#/$defs/text_or_list" },
          "condition": { "type": "string" },
          "slices": { "type": "array", "items": { "$ref": "#/$defs/slice" } }
        }
      }
    },
    "non_content_settings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "note"],
        "properties": {
          "key": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } },
    "owner_decisions": { "type": "array", "items": { "$ref": "#/$defs/owner_decision" } }
  },
  "$defs": {
    "tier": { "enum": ["original", "observed", "measured", "inferred", "analogue"] },
    "slice": { "enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "W1",
        "W2"] },
    "text_or_list": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string" } }
      ]
    },
    "key_range": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer" },
        "max": { "type": "integer" }
      }
    },
    "source": {
      "type": "object",
      "required": ["kind", "era"],
      "properties": {
        "kind": { "enum": ["client_table", "client_code", "client_map", "official_notes", "video", "screenshot", "measurement", "in_client_calibration"] },
        "era": { "enum": ["final_live", "d11_to_shutdown", "pre_d11", "unknown"] },
        "sha256": { "type": "string" },
        "member": { "type": "string" },
        "video_id": { "type": "string" },
        "timebase": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "citation": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "type": "string" },
        "event": { "type": "string" },
        "t": { "type": "number" },
        "locator": { "type": "string" },
        "position_key": { "type": "string" }
      },
      "dependentRequired": { "event": ["t"] }
    },
    "uncertainty": {
      "type": "object",
      "required": ["unit"],
      "properties": {
        "plus_minus": { "type": "number", "minimum": 0 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "horizontal_m": { "type": "number", "minimum": 0 },
        "vertical_m": { "type": "number", "minimum": 0 },
        "unit": { "type": "string" },
        "method": { "type": "string" }
      },
      "anyOf": [
        { "required": ["plus_minus"] },
        { "required": ["min", "max"] },
        { "required": ["horizontal_m"] },
        { "required": ["vertical_m"] }
      ]
    },
    "field": {
      "type": "object",
      "required": ["value", "tier", "citations"],
      "properties": {
        "value": {},
        "tier": { "$ref": "#/$defs/tier" },
        "citations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/citation" } },
        "uncertainty": { "$ref": "#/$defs/uncertainty" },
        "reasoning": { "type": "string" },
        "counterpart": { "type": "string" },
        "required_because": { "type": "string" },
        "decision": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "tier": { "const": "measured" } } }, "then": { "required": ["uncertainty"] } },
        { "if": { "properties": { "tier": { "const": "inferred" } } }, "then": { "required": ["reasoning"] } },
        { "if": { "properties": { "tier": { "const": "analogue" } } }, "then": { "required": ["counterpart", "required_because", "decision"] } }
      ]
    },
    "row": {
      "type": "object",
      "required": ["table", "key", "slice", "migration", "fields"],
      "properties": {
        "table": { "type": "string" },
        "key": { "type": "object" },
        "slice": { "$ref": "#/$defs/slice" },
        "migration": { "type": "string" },
        "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/field" } },
        "storage_fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["value", "role"],
            "properties": {
              "value": {},
              "role": { "enum": ["surrogate_key", "storage_reference", "scope", "comment"] },
              "refers_to": { "type": "string" }
            }
          }
        }
      }
    },
    "change": {
      "type": "object",
      "required": ["date", "migration", "table", "key", "field", "old", "new", "reason", "citations"],
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "migration": { "type": "string" },
        "table": { "type": "string" },
        "key": { "type": "object" },
        "field": { "type": "string" },
        "old": {},
        "new": {},
        "reason": { "type": "string" },
        "citations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/citation" } }
      }
    },
    "owner_decision": {
      "type": "object",
      "required": ["id", "decision", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^OD-[0-9]+$" },
        "decision": { "type": "string" },
        "default": { "type": "string" },
        "status": { "enum": ["open", "approved", "rejected"] },
        "choice": { "type": "string" },
        "approved_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "record": { "type": "string" }
      },
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": { "required": ["choice", "approved_on", "record"] }
    }
  }
}
